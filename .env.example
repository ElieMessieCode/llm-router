# LLM Router Environment Configuration

# Provider API Keys (Optional: provider is disabled if omitted)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Access Control & Session (Required)
ACCESS_CODE=change-this-access-code-in-production
SESSION_SECRET=a_very_secret_and_secure_key_at_least_32_characters_long_12345

# Mock Provider (Set to 1 to force-enable deterministic mock provider for testing/demo)
MOCK_PROVIDER=1
